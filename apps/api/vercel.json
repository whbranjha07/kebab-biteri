{
  "installCommand": "cd ../.. && node scripts/vercel-install.js apps/api && npm install && npm run build --workspace=@kebab-biteri/types",
  "buildCommand": "npm run build --workspace=@kebab-biteri/api",
  "framework": null,
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.ts": { "maxDuration": 30 },
    "api/health.ts": { "maxDuration": 10 }
  }
}
