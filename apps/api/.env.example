DATABASE_URL="mongodb://localhost:27017/"
JWT_SECRET="dev-secret-change-me"
PORT=3001

# Public URLs (used to build Redsys/Sabadell callback URLs)
PUBLIC_API_URL="http://localhost:3001/api"
PUBLIC_WEB_URL="http://localhost:3000"

# ─── Banco Sabadell (Redsys TPV Virtual) ─────────────────────────────
# Get these from your Banco Sabadell TPV Virtual back office.
# SABADELL_ENV: "test" for the sandbox, "prod" for live.
SABADELL_ENV="test"
SABADELL_MERCHANT_CODE=""       # FUC — merchant code (e.g. 999008881)
SABADELL_TERMINAL="001"
SABADELL_SECRET_KEY=""          # base64 SHA-256 signing key
SABADELL_CURRENCY="978"         # 978 = EUR
SABADELL_MERCHANT_NAME="Kebab Biteri"
